# Copy to .env and fill in. `.env` is gitignored; this file is the committed template.
#
#   cp .env.example .env
#
# Both Next.js and prisma.config.ts read `.env` (Prisma via `dotenv`).

# --- Database -------------------------------------------------------------
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal?schema=public"

# For Supabase/Vercel Postgres, DATABASE_URL may be omitted:
# POSTGRES_PRISMA_URL is preferred for app queries (pooled).
# POSTGRES_URL_NON_POOLING is preferred by Prisma CLI commands (direct).
# POSTGRES_URL is accepted as a fallback for app queries.
# DATABASE_URL overrides these when set.
# POSTGRES_PRISMA_URL="..."
# POSTGRES_URL_NON_POOLING="..."
# POSTGRES_URL="..."

# Only needed for `prisma migrate diff` (used to generate SQL for a
# destructive migration, per CLAUDE.md's documented workflow — `prisma
# migrate dev`/`deploy` don't read this). A separate, disposable database:
# Prisma applies every migration to it to compute the diff, then drops it.
# docker exec -i portal-db psql -U portal -d postgres -c "CREATE DATABASE portal_shadow;"
# SHADOW_DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_shadow?schema=public"

# --- Auth.js / NextAuth v5 ------------------------------------------------
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# The canonical origin of the app. Set this to the deployed HTTPS origin in
# production; do not use localhost there. Leave it unset in development —
# Auth.js then infers the origin from the request, so the app still works if
# Next falls back to another port because 3000 is taken.
# AUTH_URL="https://portal.example.com"

# --- Google OAuth ---------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email ------------------------------------------------------------------
# Optional, same as Google above: email-dependent features (invitations,
# verification, password resets) are only enabled once all three of
# SMTP_HOST/SMTP_PORT/SMTP_FROM are set.
#
# These are the BOOTSTRAP config — they apply on a fresh install and are
# superseded once an admin saves SMTP settings at /admin/email. Resolution is
# all-or-nothing on each side (database first, then these), in
# lib/email-config.ts; the two are never merged.
#
# `docker-compose.yml` runs Mailpit for local dev — no real mail account
# needed; sent mail is caught and viewable at http://localhost:8025.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Portal <noreply@portal.local>"
# SMTP_USER=""
# SMTP_PASS=""

# --- App ------------------------------------------------------------------
# Both are REQUIRED: they are validated in lib/env.ts so that a missing or
# misspelled name fails at boot rather than silently falling back to a default
# and rendering wrong project URLs across the dashboard.
#
# NEXT_PUBLIC_APP_NAME is now the FALLBACK display name and the TOTP issuer.
# The name actually shown across the app is editable at /admin/branding and
# stored in AppSettings.appName; this value applies until one is saved. The
# TOTP issuer deliberately stays on this build-time value — see
# lib/auth/totp.ts.
NEXT_PUBLIC_APP_NAME="Portal"
# A bare hostname, not a URL — used to build per-project URLs.
NEXT_PUBLIC_APP_DOMAIN="portal.local"

# --- OVEC master data (server-only; see docs/OVEC-API.md) -------------------
# Optional until reference-data screens are integrated. Never use NEXT_PUBLIC.
OVEC_API_URL="https://ovec-api.eleccom.in.th"
OVEC_API_KEY=""

# College identity displayed separately from the runtime app name.
NEXT_PUBLIC_INSTITUTION_NAME="วิทยาลัยการอาชีพลอง"
